{
  "realm": "citizens",
  "displayName": "Citizens (fake bank login for the prototype)",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "defaultDefaultClientScopes": [
    "basic",
    "profile",
    "roles",
    "web-origins"
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "access.token.claim": "true",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "web-origins",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "allowed web origins",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-allowed-origins-mapper",
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "fdx:accountbasic:read",
      "description": "FDX ACCOUNT_BASIC data cluster",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Account identifying information (name, type, masked number)"
      }
    },
    {
      "name": "fdx:paymentsupport:read",
      "description": "FDX PAYMENT_SUPPORT data cluster",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Account numbers for payments (shared as a token, not your real account number)"
      }
    }
  ],
  "roles": {
    "client": {
      "account": [
        {
          "name": "manage-account"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "aggregator-ui",
      "name": "Mock Aggregator",
      "description": "Stand-in for a data aggregator such as Plaid",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile"
      ],
      "optionalClientScopes": [
        "fdx:accountbasic:read",
        "fdx:paymentsupport:read"
      ]
    },
    {
      "clientId": "open-banking-api",
      "name": "Open Banking API",
      "description": "Service account the Open Banking API uses to check which consents still exist",
      "publicClient": false,
      "secret": "dev-only-open-banking-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "account",
      "name": "${client_account}",
      "publicClient": true,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ]
    },
    {
      "clientId": "account-console",
      "name": "${client_account-console}",
      "publicClient": true,
      "rootUrl": "${authBaseUrl}",
      "baseUrl": "/realms/citizens/account/",
      "redirectUris": [
        "/realms/citizens/account/*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "web-origins"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "account": [
          "manage-account"
        ]
      }
    },
    {
      "username": "service-account-open-banking-api",
      "enabled": true,
      "serviceAccountClientId": "open-banking-api",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ]
}